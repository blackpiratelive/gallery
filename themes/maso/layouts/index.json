{{- $output := slice -}}

{{- range .Pages.ByDate.Reverse -}}
  {{- $page := . -}}
  {{- with .Resources.GetMatch "*.{jpg,jpeg,png,JPG,JPEG,PNG}" -}}
    {{- $thumb := . | images.Resize "600x q30 webp" -}}
    
    {{/* Create a dictionary (object) for this page */}}
    {{- $item := dict 
      "title" $page.Title
      "date" ($page.Date.Format "2006-01-02")
      "tags" $page.Params.tags
      "album" $page.Params.album
      "image" (dict "original" .Permalink "thumbnail" $thumb.Permalink)
    -}}
    
    {{/* Append to the output slice */}}
    {{- $output = $output | append $item -}}
  {{- end -}}
{{- end -}}

{{/* Output the final JSON */}}
{{- $output | jsonify -}}